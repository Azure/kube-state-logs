{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "deploymentMode": {
      "type": "string",
      "enum": ["simple", "advanced"]
    },
    "daemonset": {
      "type": "object",
      "properties": {
        "kubeletPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "kubeletInsecureSkipVerify": {
          "type": "boolean"
        }
      }
    }
  }
}