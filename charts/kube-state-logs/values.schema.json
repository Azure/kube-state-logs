{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "deploymentMode": {
      "type": "string",
      "enum": [
        "simple",
        "advanced"
      ]
    },
    "daemonset": {
      "type": "object",
      "properties": {
        "useKubeletAPI": {
          "type": "boolean"
        },
        "kubeletPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "kubeletInsecureSkipVerify": {
          "type": "boolean"
        },
        "updateStrategy": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RollingUpdate",
                "OnDelete"
              ]
            },
            "rollingUpdate": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "maxUnavailable": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]+%$"
                    }
                  ]
                },
                "maxSurge": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]+%$"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RollingUpdate",
                "Recreate"
              ]
            },
            "rollingUpdate": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "maxUnavailable": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]+%$"
                    }
                  ]
                },
                "maxSurge": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]+%$"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
