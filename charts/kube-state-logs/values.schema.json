{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "deploymentMode": {
      "type": "string",
      "enum": [
        "simple",
        "advanced"
      ]
    },
    "daemonset": {
      "type": "object",
      "properties": {
        "useKubeletAPI": {
          "type": "boolean"
        },
        "kubeletPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "kubeletInsecureSkipVerify": {
          "type": "boolean"
        },
        "updateStrategy": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RollingUpdate",
                "OnDelete"
              ]
            },
            "rollingUpdate": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "maxUnavailable": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]+%$"
                    }
                  ]
                },
                "maxSurge": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]+%$"
                    }
                  ]
                }
              }
            }
          },
          "if": {
            "properties": {
              "type": {
                "const": "RollingUpdate"
              }
            }
          },
          "then": {
            "properties": {
              "rollingUpdate": {
                "description": "DaemonSet maxSurge and maxUnavailable cannot both be positive.",
                "anyOf": [
                  {
                    "properties": {
                      "maxUnavailable": {
                        "anyOf": [
                          {
                            "const": 0
                          },
                          {
                            "type": "string",
                            "pattern": "^0+%$"
                          }
                        ]
                      }
                    }
                  },
                  {
                    "properties": {
                      "maxSurge": {
                        "anyOf": [
                          {
                            "const": 0
                          },
                          {
                            "type": "string",
                            "pattern": "^0+%$"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RollingUpdate",
                "Recreate"
              ]
            },
            "rollingUpdate": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "maxUnavailable": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]+%$"
                    }
                  ]
                },
                "maxSurge": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]+%$"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
